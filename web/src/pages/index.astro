---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWorks, getFavorites, getInformationPosts, getProfile } from '../lib/data';
const [works, favorites, infoPosts, profile] = await Promise.all([
  getWorks(), getFavorites(), getInformationPosts(), getProfile()
]);
const recentWorks = works.slice(0, 1);
const recentFavorites = favorites.slice(0, 6);
const recentInfo = infoPosts.slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const splashSrc = `${base}splash.jpeg`;
---
<Base hideNav={true}>
  <div class="splash" id="splash" aria-hidden="true">
    <img class="splash__img" src={splashSrc} alt="" />
    <div class="splash__hint" id="splashHint">
      <span class="splash__hint-text">SCROLL</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <polyline points="19 12 12 19 5 12"/>
      </svg>
    </div>
  </div>

  <div class="splash-spacer" aria-hidden="true"></div>

  <div class="home container fade-in">

    <section class="home__section" aria-labelledby="about-heading">
      <div class="home__section-header">
        <h2 id="about-heading" class="home__section-title">About</h2>
        <a href={`${base}about`} class="home__more">view all</a>
      </div>
      <div class="home__about-body">
        {profile.photo && (
          <img
            class="home__about-photo"
            src={profile.photo.url}
            alt={profile.photo.alt}
            loading="lazy"
          />
        )}
        <div class="home__about-text">
          <p class="home__about-name">{profile.name}</p>
          <p class="home__about-role">{profile.title}</p>
          <p class="home__about-bio">{profile.bio.split('\n\n')[0]}</p>
        </div>
      </div>
    </section>

    <section class="home__section" aria-labelledby="info-heading">
      <div class="home__section-header">
        <h2 id="info-heading" class="home__section-title">Information</h2>
        <a href={`${base}information`} class="home__more">view all</a>
      </div>
      <ul class="home__info-list">
        {recentInfo.map((post) => (
          <li class="home__info-item">
            <a href={`${base}information/${post.slug}`} class="home__info-link">
              <time class="home__info-date" datetime={post.publishedAt}>
                {post.publishedAt.replace(/-/g, '.')}
              </time>
              <span class="home__info-title">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home__section" aria-labelledby="works-heading">
      <div class="home__section-header">
        <h2 id="works-heading" class="home__section-title">Archives</h2>
        <a href={`${base}archives`} class="home__more">view all</a>
      </div>
      <ul class="home__works-grid">
        {recentWorks.map((work) => (
          <li>
            <WorkCard work={work} href={`${base}archives`} />
          </li>
        ))}
      </ul>
    </section>

    <section class="home__section" aria-labelledby="favorite-heading">
      <div class="home__section-header">
        <h2 id="favorite-heading" class="home__section-title">Favorite</h2>
        <a href={`${base}favorite`} class="home__more">view all</a>
      </div>
      <ul class="home__fav-grid">
        {recentFavorites.map((item) => (
          <li>
            <a href={`${base}favorite/${item.slug}`}>
              <img
                class="home__fav-img"
                src={item.image.url}
                alt={item.image.alt}
                loading="lazy"
              />
            </a>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Base>

<script>
  const splash = document.getElementById('splash') as HTMLElement | null;
  const hint = document.getElementById('splashHint') as HTMLElement | null;

  if (splash) splash.style.pointerEvents = 'none';

  setTimeout(() => {
    if (hint) hint.style.opacity = '0.85';
  }, 1500);

  function onScroll() {
    const fadeDistance = window.innerHeight * 1.5;
    const ratio = Math.min(window.scrollY / fadeDistance, 1);
    if (splash) splash.style.opacity = String(1 - ratio);
    if (hint) hint.style.opacity = String(Math.max(0, 0.85 - ratio * 4));
  }

  window.addEventListener('scroll', onScroll);
</script>

<style>
  /* ===== スプラッシュ ===== */
  .splash {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .splash__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .splash__hint {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    opacity: 0;
    transition: opacity 1s ease;
    animation: hintBob 1.6s ease-in-out infinite;
  }

  .splash__hint-text {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
  }

  @keyframes hintBob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  .splash-spacer {
    height: 200vh;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash { display: none; }
    .splash-spacer { display: none; }
  }

  /* ===== ホーム ===== */
  .home {
    padding-block: var(--space-2xl) var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .home__section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .home__section-title {
    font-size: var(--font-size-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-light);
  }

  .home__more {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    text-decoration: none;
    opacity: 0.6;
    transition: opacity var(--transition-base);
  }

  .home__more:hover {
    opacity: 1;
  }

  /* Works 1枚大きく */
  .home__works-grid {
    list-style: none;
  }

  /* Favorite グリッド */
  .home__fav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
    list-style: none;
  }

  @media (min-width: 768px) {
    .home__fav-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: var(--space-sm);
    }
  }

  .home__fav-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  /* Information リスト */
  .home__info-list {
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
  }

  .home__info-item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
  }

  .home__info-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: opacity var(--transition-base);
  }

  .home__info-link:hover {
    opacity: 0.6;
  }

  .home__info-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .home__info-title {
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
  }

  /* About スニペット */
  .home__about-body {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .home__about-photo {
    width: 80px;
    height: 80px;
    object-fit: cover;
    flex-shrink: 0;
    border-radius: 2px;
  }

  @media (min-width: 768px) {
    .home__about-photo {
      width: 100px;
      height: 100px;
    }
  }

  .home__about-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .home__about-name {
    font-size: var(--font-size-lg);
    font-weight: 400;
    line-height: var(--line-height-tight);
  }

  .home__about-role {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }

  .home__about-bio {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-base);
    margin-top: var(--space-xs);
    max-width: 36em;
  }
</style>
