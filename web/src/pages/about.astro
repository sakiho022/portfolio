---
import Base from '../layouts/Base.astro';
import { getSiteSettings, getProfile } from '../lib/data';

const [settings, profile] = await Promise.all([getSiteSettings(), getProfile()]);

const socialLabels: Record<string, string> = {
  instagram: 'Instagram',
  x: 'X (旧Twitter)',
  behance: 'Behance',
  other: 'SNS',
};
---
<Base title="About" description={`${profile.name} — ${profile.title}。${profile.bio.split('\n')[0]}`}>
  <div class="about container fade-in">

    <div class="about__body">
      <section class="about__section" aria-labelledby="bio-heading">
        <h2 id="bio-heading" class="about__section-title">ぼくについて</h2>
        <div class="about__section-body">
          {profile.bio.split('\n\n').map((para) => (
            <p class="about__bio-para">{para}</p>
          ))}
        </div>
      </section>

      {profile.skills && profile.skills.length > 0 && (
        <section class="about__section" aria-labelledby="skills-heading">
          <h2 id="skills-heading" class="about__section-title">できること</h2>
          <div class="about__section-body">
            <ul class="about__skills">
              {profile.skills.map((skill) => (
                <li class="about__skill-item">{skill}</li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {profile.career && profile.career.length > 0 && (
        <section class="about__section" aria-labelledby="career-heading">
          <h2 id="career-heading" class="about__section-title">個人略歴</h2>
          <div class="about__section-body">
            <dl class="about__career">
              {profile.career.map((item) => (
                <>
                  <dt class="about__career-year">{item.year}</dt>
                  <dd class="about__career-text">{item.text}</dd>
                </>
              ))}
            </dl>
          </div>
        </section>
      )}

      <section class="about__section" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="about__section-title">連絡先</h2>
        <div class="about__section-body">
          <nav class="about__social" aria-label="ソーシャルリンク">
            {settings.socialLinks.map((link) => (
              <a
                href={link.url}
                class="about__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={socialLabels[link.platform] ?? 'SNS'}
              >
                {link.platform === 'instagram' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <rect x="2" y="2" width="20" height="20" rx="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                )}
                {link.platform === 'x' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
                {link.platform === 'behance' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 1.2.836 1.884 2.101 1.884 1.196 0 1.808-.465 2.109-1.25l3.546.395zm-5.878-4h-3.43c.105-1.21.688-1.928 1.716-1.928 1.027 0 1.614.717 1.714 1.928zM0 5h8.5C11 5 13 6.344 13 9c0 1.5-.75 2.688-2 3.25C12.5 12.844 13 14.219 13 15.5 13 18 11 19 8.5 19H0V5zm2 5.5h5.5c1.104 0 2-.896 2-2s-.896-2-2-2H2v4zm0 4h5.5c1.381 0 2.5-.672 2.5-2s-1.119-2-2.5-2H2v4z"/>
                  </svg>
                )}
                {link.platform === 'other' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                )}
              </a>
            ))}
          </nav>
          {settings.email && (
            <p class="about__email">
              <a href={`mailto:${settings.email}`}>{settings.email}</a>
            </p>
          )}
        </div>
      </section>

      {profile.photo && (
        <div class="about__photo-wrap">
          <img
            class="about__photo"
            src={profile.photo.url}
            alt={profile.photo.alt}
            width="680"
            height="453"
            loading="eager"
          />
        </div>
      )}
    </div>

  </div>
</Base>

<style>
  .about {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    max-width: 680px;
    margin-inline: auto;
  }

  .about__photo-wrap {
    margin-top: var(--space-xl);
  }

  .about__photo {
    width: 60%;
    display: block;
  }

  .about__section-title {
    font-size: var(--font-size-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: var(--space-sm);
  }

  .about__section-body {
    border-left: 1px solid var(--color-text);
    padding-left: var(--space-md);
  }

  .about__bio-para {
    margin-bottom: var(--space-sm);
    max-width: 38em;
  }

  .about__bio-para:last-child {
    margin-bottom: 0;
  }

  .about__skills {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    list-style: none;
  }

  .about__skill-item {
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
  }

  .about__career {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-xs) var(--space-sm);
    align-items: baseline;
  }

  .about__career-year {
    font-size: var(--font-size-sm);
    font-weight: 600;
    padding-top: 0.1em;
  }

  .about__career-text {
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
  }

  .about__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .about__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .about__social-link:hover {
    color: var(--color-text-hover);
  }

  .about__email {
    font-size: var(--font-size-sm);
  }

  .about__email a {
    text-decoration: none;
  }
</style>
