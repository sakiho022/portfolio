---
import type { Work } from '../types';

interface Props {
  work: Work;
}

const { work } = Astro.props;
---
<article class="work-card">
  <a href={`/works/${work.slug}`} class="work-card__link">
    <div class="work-card__thumbnail">
      <img
        src={work.thumbnail.url}
        alt={work.thumbnail.alt}
        width="800"
        height="450"
        loading="lazy"
      />
    </div>
    <h2 class="work-card__title">{work.title}</h2>
  </a>
</article>

<style>
  .work-card__link {
    display: block;
    text-decoration: none;
    color: var(--color-text);
  }

  .work-card__thumbnail {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .work-card__thumbnail::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0);
    transition: background var(--transition-base);
  }

  .work-card__link:hover .work-card__thumbnail::after {
    background: rgb(255 255 255 / 0.18);
  }

  .work-card__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .work-card__link:hover .work-card__thumbnail img {
    transform: scale(1.03);
  }

  .work-card__link:focus-visible {
    outline: none;
  }

  .work-card__link:focus-visible .work-card__thumbnail {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .work-card__title {
    margin-top: var(--space-xs);
    font-size: var(--font-size-base);
    font-weight: 400;
    color: var(--color-text);
    line-height: var(--line-height-tight);
    transition: color var(--transition-base);
  }

  .work-card__link:hover .work-card__title,
  .work-card__link:focus-visible .work-card__title {
    color: var(--color-text-muted);
  }
</style>
