---
import type { SocialLink } from '../types';

interface Props {
  socialLinks: SocialLink[];
  email?: string;
  siteTitle: string;
}

const { socialLinks, email, siteTitle } = Astro.props;

const platformLabel: Record<string, string> = {
  instagram: 'Instagram',
  x: 'X (旧Twitter)',
  behance: 'Behance',
  other: 'SNS',
};
---
<footer class="footer">
  <div class="container footer__inner">
    <nav class="footer__social" aria-label="ソーシャルリンク">
      {socialLinks.map((link) => (
        <a
          href={link.url}
          class="footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={platformLabel[link.platform] ?? 'SNS'}
        >
          {link.platform === 'instagram' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          )}
          {link.platform === 'x' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          )}
          {link.platform === 'behance' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 1.2.836 1.884 2.101 1.884 1.196 0 1.808-.465 2.109-1.25l3.546.395zm-5.878-4h-3.43c.105-1.21.688-1.928 1.716-1.928 1.027 0 1.614.717 1.714 1.928zM0 5h8.5C11 5 13 6.344 13 9c0 1.5-.75 2.688-2 3.25C12.5 12.844 13 14.219 13 15.5 13 18 11 19 8.5 19H0V5zm2 5.5h5.5c1.104 0 2-.896 2-2s-.896-2-2-2H2v4zm0 4h5.5c1.381 0 2.5-.672 2.5-2s-1.119-2-2.5-2H2v4z"/>
            </svg>
          )}
          {link.platform === 'other' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          )}
        </a>
      ))}
    </nav>

    {email && (
      <p class="footer__email">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    )}

    <p class="footer__copy">
      <small>&copy; {new Date().getFullYear()} {siteTitle}</small>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl);
    border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    /* タップしやすいよう最低44px四方を確保 */
    min-width: 44px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
    border-radius: 4px;
  }

  .footer__social-link:hover {
    color: var(--color-text-hover);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .footer__email {
    font-size: var(--font-size-sm);
  }

  .footer__copy {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    opacity: 0.6;
  }
</style>
