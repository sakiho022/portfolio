---
import type { SocialLink } from '../types';

interface Props {
  socialLinks: SocialLink[];
  email?: string;
  siteTitle: string;
}

const { socialLinks, email, siteTitle } = Astro.props;

const platformLabel: Record<string, string> = {
  instagram: 'Instagram',
  threads: 'Threads',
  x: 'X',
  tumblr: 'Tumblr',
  behance: 'Behance',
  other: 'SNS',
};
---
<footer class="footer">
  <div class="container footer__inner">
    <nav class="footer__social" aria-label="ソーシャルリンク">
      {socialLinks.map((link) => (
        <a
          href={link.url}
          class="footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={platformLabel[link.platform] ?? 'SNS'}
        >
          {link.platform === 'instagram' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          )}
          {link.platform === 'threads' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.028-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.348-.79-.987-1.43-1.88-1.864-.229 1.585-.801 2.895-1.706 3.904-1.083 1.21-2.554 1.88-4.394 1.992-1.478.088-2.906-.276-4.024-1.025-1.413-.935-2.177-2.368-2.222-4.042-.048-1.818.718-3.349 2.157-4.316 1.355-.912 3.167-1.372 5.386-1.367.568.002 1.143.025 1.719.067-.148-.95-.49-1.675-1.03-2.164-.69-.625-1.72-.944-3.063-.952h-.03c-.927 0-2.24.317-3.049 1.805l-1.793-1.035C7.224 3.14 9.044 2.413 11.1 2.4h.04c1.853.012 3.396.484 4.588 1.403 1.18.911 1.943 2.26 2.274 4.014.144.77.217 1.594.221 2.457.008.178.01.35.007.52.858.453 1.58 1.077 2.155 1.86 1.003 1.368 1.396 3.265.99 5.158-.482 2.256-1.912 4.062-4.098 5.227C15.594 23.554 14.002 24 12.186 24zm-.351-9.524c1.404-.084 2.427-.554 3.038-1.4.477-.653.743-1.527.802-2.61-.54-.049-1.08-.074-1.608-.076-1.715-.005-3.066.294-3.979.884-.787.53-1.162 1.264-1.137 2.18.04 1.437 1.013 2.098 2.884 2.022z"/>
            </svg>
          )}
          {link.platform === 'tumblr' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M14.563 24c-5.093 0-7.031-3.756-7.031-6.411V9.747H5.116V6.648c3.63-1.313 4.512-4.596 4.71-6.469C9.84.051 9.941 0 9.999 0h3.517v6.114h4.801v3.633h-4.82v7.47c.016 1.001.375 2.371 2.207 2.371h.09c.631-.02 1.486-.205 1.936-.419l1.156 3.425c-.436.636-2.4 1.374-4.304 1.406z"/>
            </svg>
          )}
          {link.platform === 'x' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          )}
          {link.platform === 'behance' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029zm-7.249-4h4.56c-.063-1.687-1.048-2.351-2.249-2.351-1.291 0-2.057.74-2.311 2.351zM1 22V2h8.005c4.612 0 6.27 2.614 6.27 5.11 0 1.695-.809 3.31-2.495 4.084 2.016.64 3.406 2.41 3.406 4.73 0 3.32-2.338 6.076-7.028 6.076H1zm3.5-11.5h3.5c1.88 0 2.878-1.062 2.878-2.505C10.878 6.56 9.88 5.5 8 5.5H4.5V10.5zm0 8h4c2.102 0 3.5-1.093 3.5-2.965C12 13.572 10.602 12.5 8.5 12.5H4.5V18.5z"/>
            </svg>
          )}
          {link.platform === 'other' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          )}
        </a>
      ))}
    </nav>

    {email && (
      <p class="footer__email">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    )}

    <p class="footer__copy">
      <small>&copy; {new Date().getFullYear()} {siteTitle}</small>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl);
    border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    /* タップしやすいよう最低44px四方を確保 */
    min-width: 44px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
    border-radius: 4px;
  }

  .footer__social-link:hover {
    color: var(--color-text-hover);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .footer__email {
    font-size: var(--font-size-sm);
  }

  .footer__copy {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    opacity: 0.6;
  }
</style>
