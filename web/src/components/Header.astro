---
interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
const currentPath = Astro.url.pathname;

const isCurrentPage = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---
<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">{siteTitle}</a>

    <button
      class="header__hamburger"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="header-menu"
    >
      <span class="header__bar"></span>
      <span class="header__bar"></span>
      <span class="header__bar"></span>
    </button>

    <nav class="header__nav" id="header-menu" aria-label="メインナビゲーション">
      <ul class="header__nav-list">
        <li>
          <a
            href="/"
            class="header__nav-link"
            aria-current={currentPath === '/' || currentPath.startsWith('/page/') || currentPath.startsWith('/works/') ? 'page' : undefined}
          >
            Works
          </a>
        </li>
        <li>
          <a
            href="/information"
            class="header__nav-link"
            aria-current={isCurrentPage('/information') ? 'page' : undefined}
          >
            Information
          </a>
        </li>
        <li>
          <a
            href="/about"
            class="header__nav-link"
            aria-current={isCurrentPage('/about') ? 'page' : undefined}
          >
            About
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('.header__hamburger') as HTMLButtonElement;
  const nav = document.getElementById('header-menu') as HTMLElement;

  btn.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    nav.classList.toggle('is-open', !isOpen);
    btn.setAttribute('aria-label', isOpen ? 'メニューを開く' : 'メニューを閉じる');
  });

  nav.querySelectorAll('.header__nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      btn.setAttribute('aria-label', 'メニューを開く');
    });
  });
</script>

<style>
  /* ===== 共通 ===== */
  .header {
    padding-block: var(--space-sm);
    position: static;
    z-index: 100;
    background-color: var(--color-bg);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .header__logo {
    font-size: var(--font-size-xl);
    color: var(--color-text-light);
    text-decoration: none;
    font-weight: 400;
    letter-spacing: 0.05em;
    transition: color var(--transition-base);
    position: relative;
    z-index: 101;
  }

  .header__logo:hover {
    color: var(--color-text-hover);
    text-decoration: none;
  }

  /* ===== デスクトップ ナビ ===== */
  .header__hamburger {
    display: none;
  }

  .header__nav {
    display: block;
  }

  .header__nav-list {
    display: flex;
    flex-direction: row;
    gap: var(--space-md);
    align-items: center;
  }

  .header__nav-link {
    font-size: var(--font-size-sm);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 400;
    color: color-mix(in srgb, var(--color-text) 45%, transparent);
    padding-block: var(--space-2xs);
    transition: color var(--transition-base);
  }

  .header__nav-link:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .header__nav-link[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ===== モバイル専用 ===== */
  @media (max-width: 767px) {
    .header {
      padding-block: var(--space-sm);
    }

    .header:has(.header__nav.is-open) {
      background-color: var(--color-text);
      position: sticky;
      top: 0;
    }

    .header:has(.header__nav.is-open) .header__logo {
      color: var(--color-bg);
    }

    .header__hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 10px;
      position: relative;
      z-index: 101;
    }

    .header__bar {
      display: block;
      width: 100%;
      height: 2px;
      background-color: var(--color-text);
      transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
      transform-origin: center;
    }

    .header__hamburger[aria-expanded='true'] .header__bar {
      background-color: var(--color-bg);
    }

    .header__hamburger[aria-expanded='true'] .header__bar:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .header__hamburger[aria-expanded='true'] .header__bar:nth-child(2) {
      transform: scaleX(0);
      opacity: 0;
    }

    .header__hamburger[aria-expanded='true'] .header__bar:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }

    .header__nav {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background-color: var(--color-text);
      z-index: 99;
      padding-top: 7rem;
      padding-bottom: var(--space-2xl);
      padding-inline: var(--content-padding);
    }

    .header__nav.is-open {
      display: block;
    }

    .header__nav-list {
      flex-direction: column;
      gap: var(--space-xs);
      align-items: flex-start;
    }

    .header__nav-link {
      font-size: var(--font-size-lg);
      color: var(--color-bg);
      text-transform: none;
      letter-spacing: 0.05em;
      font-weight: 400;
      transition: opacity var(--transition-base);
    }

    .header__nav-link:hover {
      color: var(--color-bg);
      opacity: 0.6;
    }

    .header__nav-link[aria-current='page'] {
      font-weight: 400;
      color: var(--color-bg);
    }

    .header__nav-link[aria-current='page']::after {
      content: ' ◀';
      font-size: 0.9em;
      opacity: 0.7;
    }
  }

  @media (min-width: 768px) {
    .header {
      padding-block: var(--space-md);
    }
  }
</style>
